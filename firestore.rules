rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper: Check if the existing document belongs to the authenticated user via the userId field
    function isOwner() {
      return isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
    }

    // Helper: Check if the incoming document sets the userId field to the authenticated user's UID
    function isIncomingOwner() {
      return isAuthenticated() && request.resource != null && request.resource.data.userId == request.auth.uid;
    }

    // Users collection: user owns document if document ID is their auth UID or document contains their userId
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      allow create: if isAuthenticated() && (request.auth.uid == userId || isIncomingOwner());
      allow update: if isAuthenticated() && (request.auth.uid == userId || (isOwner() && isIncomingOwner()));
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isOwner());
    }

    // Artists collection: users can only read, create, update, and delete their own artist profiles
    match /artists/{artistId} {
      allow read: if isOwner();
      allow create: if isIncomingOwner();
      allow update: if isOwner() && isIncomingOwner();
      allow delete: if isOwner();
    }

    // Gigs collection: users can only read, create, update, and delete their own scheduled gigs
    match /gigs/{gigId} {
      allow read: if isOwner();
      allow create: if isIncomingOwner();
      allow update: if isOwner() && isIncomingOwner();
      allow delete: if isOwner();
    }

    // Songs collection: users can only read, create, update, and delete their own repertoire
    match /songs/{songId} {
      allow read: if isOwner();
      allow create: if isIncomingOwner();
      allow update: if isOwner() && isIncomingOwner();
      allow delete: if isOwner();
    }

    // Setlists collection: users can only read, create, update, and delete their own setlists
    match /setlists/{setlistId} {
      allow read: if isOwner();
      allow create: if isIncomingOwner();
      allow update: if isOwner() && isIncomingOwner();
      allow delete: if isOwner();
    }

    // Budgets collection: users can only read, create, update, and delete their own budget items
    match /budgets/{budgetId} {
      allow read: if isOwner();
      allow create: if isIncomingOwner();
      allow update: if isOwner() && isIncomingOwner();
      allow delete: if isOwner();
    }

    // Captured Emails / Leads collection: users can only read, create, update, and delete their own fan leads
    match /captured_emails/{leadId} {
      allow read: if isOwner();
      allow create: if isIncomingOwner();
      allow update: if isOwner() && isIncomingOwner();
      allow delete: if isOwner();
    }

    // Campaigns collection: users can only read, create, update, and delete their own promo campaigns
    match /campaigns/{campaignId} {
      allow read: if isOwner();
      allow create: if isIncomingOwner();
      allow update: if isOwner() && isIncomingOwner();
      allow delete: if isOwner();
    }

    // Collaboration Requests collection: users can only read and manage their own collaboration requests
    match /collaboration_requests/{requestId} {
      allow read: if isOwner();
      allow create: if isIncomingOwner();
      allow update: if isOwner() && isIncomingOwner();
      allow delete: if isOwner();
    }

    // Catch-all rule for all other data collections enforcing userId ownership
    match /{collectionId}/{docId} {
      allow read: if isOwner();
      allow create: if isIncomingOwner();
      allow update: if isOwner() && isIncomingOwner();
      allow delete: if isOwner();
    }
  }
}
